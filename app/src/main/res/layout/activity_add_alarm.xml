<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F6F2EC"
    android:orientation="vertical">

    <!-- 상단 화살표 -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:layout_marginStart="12dp"
        android:layout_marginTop="38dp"
        android:layout_marginEnd="12dp">

        <ImageButton
            android:id="@+id/btnBackCircle"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:layout_gravity="start|center_vertical"
            android:layout_marginStart="6dp"
            android:background="@drawable/bg_circle_back_button"
            android:contentDescription="뒤로가기"
            android:padding="14dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_chevron_left" />
    </FrameLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:paddingStart="12dp"
        android:paddingEnd="12dp">

        <!-- STEP 1 -->
        <ScrollView
            android:id="@+id/step1Container"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="top"
                android:orientation="vertical"
                android:paddingTop="80dp"
                android:paddingBottom="24dp">

                <!-- 제목: 1-2 있던 자리로 위로 이동 -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="약을 선택해주세요"
                    android:textColor="#222222"
                    android:textSize="28sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:id="@+id/selectPillBox"
                    android:layout_width="match_parent"
                    android:layout_height="72dp"
                    android:layout_marginTop="22dp"
                    android:background="@drawable/bg_select_box_active"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="20dp"
                    android:paddingEnd="18dp">

                    <TextView
                        android:id="@+id/tvSelectedPill"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="약을 선택해주세요"
                        android:textColor="#222222"
                        android:textSize="24sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvDropdownArrow"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:text="▾"
                        android:textColor="#666666"
                        android:textSize="24sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- 복용 요일: 현재 위치감 유지 -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="64dp"
                    android:gravity="center"
                    android:text="복용 요일"
                    android:textColor="#222222"
                    android:textSize="28sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/btnEveryDay"
                        android:layout_width="0dp"
                        android:layout_height="60dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_day_chip"
                        android:gravity="center"
                        android:text="매일"
                        android:textColor="#222222"
                        android:textSize="22sp"
                        android:textStyle="bold" />

                    <Space
                        android:layout_width="12dp"
                        android:layout_height="1dp" />

                    <TextView
                        android:id="@+id/btnManualDays"
                        android:layout_width="0dp"
                        android:layout_height="60dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_day_chip"
                        android:gravity="center"
                        android:text="요일 선택"
                        android:textColor="#222222"
                        android:textSize="22sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="28dp"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvMon"
                        android:layout_width="64dp"
                        android:layout_height="64dp"
                        android:background="@drawable/bg_day_chip"
                        android:gravity="center"
                        android:text="월"
                        android:textColor="#A9A39B"
                        android:textSize="22sp"
                        android:textStyle="bold" />

                    <Space
                        android:layout_width="10dp"
                        android:layout_height="1dp" />

                    <TextView
                        android:id="@+id/tvTue"
                        android:layout_width="64dp"
                        android:layout_height="64dp"
                        android:background="@drawable/bg_day_chip"
                        android:gravity="center"
                        android:text="화"
                        android:textColor="#A9A39B"
                        android:textSize="22sp"
                        android:textStyle="bold" />

                    <Space
                        android:layout_width="10dp"
                        android:layout_height="1dp" />

                    <TextView
                        android:id="@+id/tvWed"
                        android:layout_width="64dp"
                        android:layout_height="64dp"
                        android:background="@drawable/bg_day_chip"
                        android:gravity="center"
                        android:text="수"
                        android:textColor="#A9A39B"
                        android:textSize="22sp"
                        android:textStyle="bold" />

                    <Space
                        android:layout_width="10dp"
                        android:layout_height="1dp" />

                    <TextView
                        android:id="@+id/tvThu"
                        android:layout_width="64dp"
                        android:layout_height="64dp"
                        android:background="@drawable/bg_day_chip"
                        android:gravity="center"
                        android:text="목"
                        android:textColor="#A9A39B"
                        android:textSize="22sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvFri"
                        android:layout_width="64dp"
                        android:layout_height="64dp"
                        android:background="@drawable/bg_day_chip"
                        android:gravity="center"
                        android:text="금"
                        android:textColor="#A9A39B"
                        android:textSize="22sp"
                        android:textStyle="bold" />

                    <Space
                        android:layout_width="10dp"
                        android:layout_height="1dp" />

                    <TextView
                        android:id="@+id/tvSat"
                        android:layout_width="64dp"
                        android:layout_height="64dp"
                        android:background="@drawable/bg_day_chip"
                        android:gravity="center"
                        android:text="토"
                        android:textColor="#A9A39B"
                        android:textSize="22sp"
                        android:textStyle="bold" />

                    <Space
                        android:layout_width="10dp"
                        android:layout_height="1dp" />

                    <TextView
                        android:id="@+id/tvSun"
                        android:layout_width="64dp"
                        android:layout_height="64dp"
                        android:background="@drawable/bg_day_chip"
                        android:gravity="center"
                        android:text="일"
                        android:textColor="#A9A39B"
                        android:textSize="22sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>
        </ScrollView>

        <!-- STEP 2 -->
        <LinearLayout
            android:id="@+id/step2Container"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:visibility="gone"
            android:paddingTop="6dp">

            <TextView
                android:id="@+id/tvStep2Title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:includeFontPadding="false"
                android:text="복용 시간을 설정해주세요"
                android:textColor="#222222"
                android:textSize="28sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnAddTime"
                android:layout_width="match_parent"
                android:layout_height="66dp"
                android:layout_marginTop="18dp"
                android:background="@drawable/bg_step2_add_time_white"
                android:text="시간 추가"
                android:textAllCaps="false"
                android:textAppearance="@style/UnifiedBottomButtonText"
                android:textColor="#222222" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvTimes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:nestedScrollingEnabled="false"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tvTimeGuide"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:gravity="center"
                android:text="알림을 1개 이상&#10;추가해주세요"
                android:textColor="#6B645C"
                android:textSize="24sp"
                android:textStyle="normal"
                android:lineSpacingExtra="8dp" />
        </LinearLayout>
    </FrameLayout>

    <Button
        android:id="@+id/btnBottom"
        android:layout_width="match_parent"
        android:layout_height="66dp"
        android:layout_marginStart="12dp"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="12dp"
        android:layout_marginBottom="38dp"
        android:background="@drawable/bg_primary_button"
        android:text="다음"
        android:textAllCaps="false"
        android:textAppearance="@style/UnifiedBottomButtonText"
        android:textColor="#222222" />

</LinearLayout>