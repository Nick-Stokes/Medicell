<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="AppTheme" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="colorPrimary">#F07E46</item>
        <item name="colorPrimaryDark">#F07E46</item>
        <item name="colorAccent">#F07E46</item>
        <item name="android:statusBarColor">#F6F2EC</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <!-- 하단 주요 버튼 글자 크기 통일 -->
    <style name="UnifiedBottomButtonText">
        <item name="android:textSize">28sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:fontFamily">sans-serif</item>
    </style>

    <style name="AlarmPillNameText">
        <item name="android:textSize">22sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">#222222</item>
    </style>

    <style name="EmptyGuideText">
        <item name="android:textColor">#666666</item>
        <item name="android:textSize">25sp</item>
        <item name="android:textStyle">normal</item>
    </style>

</resources>